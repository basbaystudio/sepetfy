# ------------------------------------------------------------------
# Sepetfy ayar şablonu
# NOT: Değerin yanına yorum yazmayın (Docker desteklemez); yorumlar ayrı satırda olmalı.
# Kullanım:  cp .env.example .env   ve değerleri .env içine yazın.
# .env dosyası Git'e EKLENMEZ. API anahtarlarını sohbete yapıştırmayın.
# ------------------------------------------------------------------

# --- Genel ---
# development | production
APP_ENV=development
LOG_LEVEL=INFO
TIMEZONE=Europe/Istanbul

# --- Veritabanı ---
# Başlangıç: SQLite (ek maliyet yok). Büyüyünce PostgreSQL:
# POSTGRES_PASSWORD=guclu-bir-sifre
# DOCKER_DATABASE_URL=postgresql+psycopg://sepetfy:guclu-bir-sifre@db:5432/sepetfy
DATABASE_URL=sqlite:///data/sepetfy.db

# --- GÜVENLİK ŞALTERLERİ ---
# Varsayılan olarak HİÇBİR ŞEY yayınlanmaz. Onay mekanizması her durumda zorunludur;
# bu şalterler ek bir güvenlik katmanıdır.
PUBLISHING_ENABLED=false
DRY_RUN=true

# --- Telegram (FAZ 5) ---
# @BotFather'dan alınan token ve SADECE sizin Telegram kullanıcı ID'niz (virgülle çoklu)
# Kurulum rehberi: docs/TELEGRAM.md
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_USER_IDS=
# Bir seferde onaya sunulacak en fazla fırsat
TELEGRAM_MAX_PREVIEWS=5

# --- Claude API (FAZ 3) --- console.anthropic.com > API Keys
# (Claude Code aboneliğinden AYRI faturalanır)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- Gemini API (FAZ 4) --- aistudio.google.com > Get API key
GEMINI_API_KEY=

# --- Kling (FAZ 4) --- Resmî geliştirici platformu erişimi doğrulandıktan sonra
KLING_ACCESS_KEY=
KLING_SECRET_KEY=

# --- Ürün feed'leri (FAZ 2) ---
# Affiliate panelinden alınan XML feed linki. İçinde size özel token olur: sohbete yapıştırmayın.
# Alan eşleştirmesi: sepetfy/config/feeds/<ad>.json
HEPSIBURADA_FEED_URL=

# --- Maliyet kontrolü ---
MONTHLY_BUDGET_USD=30
# bütçenin %80'inde Telegram uyarısı
BUDGET_WARN_RATIO=0.8
# limit aşılınca ücretli çağrıları durdur
BUDGET_HARD_STOP=true

# --- Zamanlama ---
# kaynak izin verdiği ölçüde 5-15 dk
DEFAULT_CHECK_INTERVAL_MIN=15

# --- Yedekleme ---
BACKUP_DIR=backups
BACKUP_KEEP=14
